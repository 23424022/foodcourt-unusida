PORT=3000

# MySQL (Aiven: Service Overview -> Connection Information)
DB_HOST=your_aiven_host
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database
# Aiven wajib SSL. Untuk MySQL lokal isi false.
DB_SSL=true

# Teks acak panjang untuk menandatangani login (JANGAN pakai nilai contoh ini)
JWT_SECRET=replace_with_a_long_random_secret

# (Opsional) Batasi domain frontend yang boleh akses API, pisahkan dengan koma.
# Kosong = semua boleh. Contoh: https://foodcourt.vercel.app
CORS_ORIGIN=

# (Opsional) Cloudinary untuk foto menu/QRIS. Kalau kosong, gambar disimpan di database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# QRIS via GoPay Merchant + Mutasiku (Payments API, tipe QRIS-DYNAMIC): SATU akun untuk SELURUH kantin.
# Kosong = QRIS nonaktif, pelanggan hanya bisa bayar Cash.
MUTASIKU_API_KEY=
# UUID akun GoPay Merchant yang sudah dihubungkan di dashboard Mutasiku (lihat GET /api/v1/accounts)
MUTASIKU_WALLET_ACCOUNT_ID=
# Secret webhook (dashboard Mutasiku -> Settings -> Webhooks), dipakai memverifikasi X-Webhook-Signature
MUTASIKU_WEBHOOK_SECRET=
# URL tujuan setelah bayar (wajib oleh Mutasiku). Isi alamat aplikasimu, contoh https://foodcourt.onrender.com
MUTASIKU_REDIRECT_URL=
# (Opsional) default https://mutasiku.co.id
MUTASIKU_BASE_URL=https://mutasiku.co.id
# true = MODE SIMULASI tanpa GoPay/Mutasiku (QR palsu + tombol "simulasi bayar"), hanya untuk tes lokal / demo
MUTASIKU_MOCK=false
